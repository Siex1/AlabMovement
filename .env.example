# ==========================================
# Alab Movement - Environment Template
# ==========================================
# Set environment: 'testing' or 'production'
APP_ENV=testing
APP_NAME="Alab Movement"
APP_PORT=3000

# Database Settings
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alabmovement_db
DB_USER=db_user
DB_PASSWORD=your_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security / JWT / Session Secrets
APP_KEY=replace_with_a_secure_random_key
