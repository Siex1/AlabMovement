# ==========================================
# Alab Movement - PRODUCTION ENVIRONMENT
# ==========================================
# Live production environment configuration
APP_ENV=production
APP_NAME="Alab Movement"
APP_PORT=8080
DEBUG=false

# Production Database Settings
DB_DIALECT=postgres
DB_HOST=db.prod.alabmovement.com
DB_PORT=5432
DB_NAME=alabmovement_production
DB_USER=alab_prod_admin
DB_PASSWORD=production_secure_strong_password
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# Production Secret Key
APP_KEY=production_primary_secret_key_keep_confidential
